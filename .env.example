NEXT_PUBLIC_RPC_URL=
# Comma-separated wallets whose SCAMREG memos form the blacklist (e.g. game admin wallet, Veris team wallet)
BLACKLIST_SOURCES=
# Only when the API runs on another domain. Leave empty on Vercel.
NEXT_PUBLIC_API_URL=
# Comma-separated origins allowed to call the API (e.g. the main game site). Empty = allow all.
ALLOWED_ORIGINS=
# AI scam detector guard (Phase 13): true = call /api/analyze before signing swaps
NEXT_PUBLIC_AI_ENABLED=true
# URL of the AI service (verified in server logs; proxy defaults to localhost:8000)
AI_SERVICE_URL=http://localhost:8000
# Solana RPC for on-chain context (Section C)
SOLANA_RPC_URL=https://api.devnet.solana.com
# veris_registry program id — TODO: replace after devnet deploy (Section C)
VERIS_REGISTRY_PROGRAM_ID=9ukmHJeMxEUtzSJf6gsdqgUgcEL8P9LJyeamW2RiSbEE

